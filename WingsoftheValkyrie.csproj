<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>WingsoftheValkyrie</AssemblyName>
    <Description>Valheim Wings of the Valkyrie Mod</Description>
    <Version>2.0.2</Version>
    <!-- Gale test-profile deploy target for the DeployLocal step below (Linux path). -->
    <GaleProfilePlugins>$(HOME)/.local/share/com.kesomannen.gale/valheim/profiles/The Tester/BepInEx/plugins/Wubarrk-Wings_of_the_Valkyrie</GaleProfilePlugins>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- ALL reference assemblies come from the SHARED c:\WubarrkCODING\libs-Tools folder, never from a per-project
       libs\ copy. That is the standing rule across every mod in this solution root. -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\libs-Tools\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\libs-Tools\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="Jotunn">
      <HintPath>..\libs-Tools\Jotunn.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>..\libs-Tools\assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>..\libs-Tools\assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>..\libs-Tools\assembly_guiutils.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\libs-Tools\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\libs-Tools\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\libs-Tools\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>..\libs-Tools\UnityEngine.ParticleSystemModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\libs-Tools\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\libs-Tools\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Facade only: ImageConversionModule is compiled against netstandard 2.1, which net48
         alone cannot see. Never copied to output; the game supplies the real one. -->
    <Reference Include="netstandard">
      <HintPath>..\libs-Tools\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- tests/ holds standalone net8 harnesses that compile the mod's own source files against
       stubs (see tests/README.md). The SDK globs **/*.cs by default, so they must be removed
       explicitly or the plugin build would try to compile the harnesses and their stubs. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <!-- Icon art ships inside the DLL so the mod stays a single-file plugin. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/Icons/*.png" />
  </ItemGroup>

  <!-- Release builds land directly in the Hexium staging folder and the Gale test profile,
       so the 1.9.x test loop is build-and-launch. -->
  <Target Name="DeployLocal" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)HexiumDist/WingsoftheValkyrie/plugins" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GaleProfilePlugins)" Condition="Exists('$(GaleProfilePlugins)')" />
  </Target>
</Project>
