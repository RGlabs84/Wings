<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>WingsoftheValkyrie</AssemblyName>
    <Description>Valheim Wings of the Valkyrie Mod</Description>
    <Version>2.1.1</Version>
    <!-- Gale test-profile deploy, OFF by default. Build with -p:DeployToGale=true to opt in.
         It is off because the test rig has ONE deploy owner at a time, and client and server must
         land together: a client carrying this mod cannot even connect to a server without it
         (ServerSync ModRequired), and a DLL rewritten under a launching client has already
         hard-crashed Valheim here with a Mono SIGABRT. An automatic copy on every Release build
         is exactly the second writer that rule exists to prevent.
         NEVER point this at "Wonderland Client" or "Wonderland ADMINing": those are live server
         profiles, and this mod's builds are not always network-compatible with what they run. -->
    <DeployToGale Condition="'$(DeployToGale)' == ''">false</DeployToGale>
    <GaleProfiles>$(HOME)/.local/share/com.kesomannen.gale/valheim/profiles</GaleProfiles>
    <GaleTestProfile>Test-icles</GaleTestProfile>
    <GalePackagePath>BepInEx/plugins/Wubarrk-Wings_of_the_Valkyrie</GalePackagePath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- ServerSync.cs is shared source written with nullable reference annotations; this project
         does not opt into them, so the annotations are inert and their warning is noise. -->
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS8632</NoWarn>
  </PropertyGroup>

  <!-- ALL reference assemblies come from the SHARED c:\WubarrkCODING\libs-Tools folder, never from a per-project
       libs\ copy. That is the standing rule across every mod in this solution root. -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>..\libs-Tools\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>..\libs-Tools\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>..\libs-Tools\assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="assembly_utils">
      <HintPath>..\libs-Tools\assembly_utils.dll</HintPath>
    </Reference>
    <Reference Include="assembly_guiutils">
      <HintPath>..\libs-Tools\assembly_guiutils.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>..\libs-Tools\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>..\libs-Tools\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>..\libs-Tools\UnityEngine.PhysicsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>..\libs-Tools\UnityEngine.ParticleSystemModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>..\libs-Tools\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>..\libs-Tools\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- ServerSync's version-mismatch panel writes into the connect dialog's TMP label. Neither
         is copied to output; the game supplies the real ones. -->
    <Reference Include="UnityEngine.UI">
      <HintPath>..\libs-Tools\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>..\libs-Tools\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- Facade only: ImageConversionModule is compiled against netstandard 2.1, which net48
         alone cannot see. Never copied to output; the game supplies the real one. -->
    <Reference Include="netstandard">
      <HintPath>..\libs-Tools\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- tests/ holds standalone net8 harnesses that compile the mod's own source files against
       stubs (see tests/README.md). The SDK globs **/*.cs by default, so they must be removed
       explicitly or the plugin build would try to compile the harnesses and their stubs. -->
  <ItemGroup>
    <Compile Remove="tests/**" />
    <None Remove="tests/**" />
    <EmbeddedResource Remove="tests/**" />
  </ItemGroup>

  <!-- Config sync + the client/server version handshake, in place of Jotunn's config manager
       and its [NetworkCompatibility] attribute. Compiled from the shared copy, never vendored. -->
  <ItemGroup>
    <Compile Include="..\libs-Tools\ServerSync.cs" />
  </ItemGroup>

  <!-- Icon art ships inside the DLL so the mod stays a single-file plugin. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources/Icons/*.png" />
  </ItemGroup>

  <!-- Release builds land directly in the Hexium staging folder and the Gale test profile,
       so the 1.9.x test loop is build-and-launch. -->
  <Target Name="DeployLocal" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <GaleTestTarget>$(GaleProfiles)/$(GaleTestProfile)/$(GalePackagePath)</GaleTestTarget>
      <GalePackageStage>$(ProjectDir)HexiumDist/gale-package/Wubarrk-Wings_of_the_Valkyrie</GalePackageStage>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProjectDir)HexiumDist/WingsoftheValkyrie/plugins" />

    <!-- The complete Gale/Hexium package folder, staged in the repo rather than pushed into a
         profile. This is what a deploy should copy wholesale: every other Wubarrk package in the
         test profile carries manifest/icon/README/CHANGELOG/LICENSE beside its DLL, and a bare
         DLL leaves Gale with nothing to identify the package by. -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GalePackageStage)" />
    <Copy SourceFiles="$(ProjectDir)HexiumDist/manifest.json;$(ProjectDir)HexiumDist/icon.png;$(ProjectDir)HexiumDist/README.md;$(ProjectDir)HexiumDist/CHANGELOG.md;$(ProjectDir)LICENSE.md"
          DestinationFolder="$(GalePackageStage)" />
    <Message Importance="high" Text="Staged Gale package at $(GalePackageStage)" />

    <!-- Only into the profile itself, never creating the profile: a typo in GaleTestProfile should
         fail loudly here rather than quietly seed a plugins tree Gale knows nothing about. -->
    <Warning Text="Gale profile '$(GaleTestProfile)' not found under $(GaleProfiles) - skipping the test deploy."
             Condition="'$(DeployToGale)' == 'true' AND !Exists('$(GaleProfiles)/$(GaleTestProfile)')" />
    <MakeDir Directories="$(GaleTestTarget)" Condition="'$(DeployToGale)' == 'true' AND Exists('$(GaleProfiles)/$(GaleTestProfile)')" />
    <Copy SourceFiles="$(GalePackageStage)/WingsoftheValkyrie.dll;$(GalePackageStage)/manifest.json;$(GalePackageStage)/icon.png;$(GalePackageStage)/README.md;$(GalePackageStage)/CHANGELOG.md;$(GalePackageStage)/LICENSE.md"
          DestinationFolder="$(GaleTestTarget)" Condition="'$(DeployToGale)' == 'true' AND Exists('$(GaleProfiles)/$(GaleTestProfile)')" />
    <Message Importance="high" Text="Deployed to $(GaleTestTarget)" Condition="'$(DeployToGale)' == 'true' AND Exists('$(GaleProfiles)/$(GaleTestProfile)')" />
  </Target>
</Project>
